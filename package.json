{
  "name": "cortico",
  "version": "0.2.6",
  "private": true,
  "type": "module",
  "description": "Cortico-ADW: a persona-behavior fork of Cortico, running three long-lived digital personas (Amber, Dragon, Whale)",
  "author": "Pal AI Lab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yono-Sigtuna/Cortico-ADW.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "scripts": {
    "start": "node bin/cortico.mjs",
    "start:household": "tsx apps/household/cli.ts",
    "typecheck:household": "tsc -p apps/household/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "build:web": "tsx scripts/build-web.ts && tailwindcss -i src/web/public/styles.css -o dist/web/styles.css --minify",
    "audit:release": "tsx scripts/release-audit.ts",
    "publish:package": "tsx scripts/publish-package.ts",
    "publish:worlds": "tsx scripts/publish-worlds.ts",
    "check:extension": "tsx scripts/extension-check.ts",
    "describe:extension": "tsx scripts/extension-describe.ts",
    "logq": "tsx scripts/logq.ts",
    "wakeq": "tsx scripts/wakeq.ts",
    "memidx": "tsx scripts/memidx.ts",
    "dev:webui": "tsx scripts/dev-webui.ts",
    "bots": "tsx src/launcher.ts --list"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "canvas": "^3.2.3",
    "express": "^4.21.2",
    "fflate": "0.8.3",
    "mineflayer": "^4.37.1",
    "mineflayer-pathfinder": "^2.4.5",
    "prismarine-viewer": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-textarea-autosize": "^8.5.9",
    "tar-stream": "3.2.1",
    "vec3": "^0.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/tar-stream": "3.1.4",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
